# ============================================
# 数据库
# ============================================
DATABASE_URL=postgresql://finsim:finsim_dev_password@localhost:5432/finsim
POSTGRES_PASSWORD=finsim_dev_password

# ============================================
# NextAuth.js 认证 (v5)
# ============================================
# next-auth v5 默认读 AUTH_SECRET；auth.config.ts 已 fallback 到 NEXTAUTH_SECRET 兼容 v4 老部署。
# 新部署建议设 AUTH_SECRET；两者都生效。
AUTH_SECRET=dev-secret-change-in-production-must-be-256-bits
NEXTAUTH_SECRET=dev-secret-change-in-production-must-be-256-bits
NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# ============================================
# 管理密钥
# ============================================
ADMIN_KEY=finsim-teacher-key

# ============================================
# Cron token（可选）
# ============================================
# /api/cron/release-submissions 自动公布扫描守护：
# - 设 CRON_TOKEN 后，部署 cron 必须传 x-cron-token header（生产建议）
# - 未设 CRON_TOKEN，admin 角色用户也可手动调该 endpoint（开发/小团队）
CRON_TOKEN=

# ============================================
# AI Provider（默认）
# ============================================
AI_PROVIDER=deepseek
AI_FALLBACK_PROVIDER=deepseek

# ============================================
# 小米 MiMo（语音及既有媒体配置保留）
# ============================================
MIMO_API_KEY=tp-or-sk-xxx
# 留空时会按 key 前缀自动选择：tp-* -> token-plan-cn；sk-* -> api.xiaomimimo.com
MIMO_BASE_URL=
MIMO_MODEL=mimo-v2.5-pro
MIMO_OCR_MODEL=mimo-v2-omni
# Anthropic-compatible endpoint is kept for future SDK/provider integration.
MIMO_ANTHROPIC_BASE_URL=https://token-plan-cn.xiaomimimo.com/anthropic

# Optional search provider for AI workbench tools.
# Leave empty to keep tools grounded in uploaded/pasted materials only.
SEARCH_PROVIDER=
SEARCH_API_KEY=

# ============================================
# 通义千问 / Qwen
# ============================================
QWEN_API_KEY=sk-xxx
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 默认模型（当 feature-specific AI_*_MODEL 未设置时使用）
QWEN_MODEL=qwen3.5-plus

# 文档 OCR：优先用阿里云百炼 / DashScope Qwen-OCR
OCR_PROVIDER=qwen
QWEN_OCR_MODEL=qwen-vl-ocr
OCR_MAX_PAGES=20
OCR_MIN_TEXT_CHARS=200

# ============================================
# DeepSeek
# ============================================
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=

# ============================================
# Gemini（可选，需代理）
# ============================================
GEMINI_API_KEY=
GEMINI_PROXY_URL=

# ============================================
# OpenAI 兼容（可选）
# ============================================
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ============================================
# 按 Feature 覆盖（单源: lib/ai/text-model-policy.json）
# 文本默认DeepSeek V4 Flash；复杂评分/生成/洞察使用V4 Pro。
# DEEPSEEK_MODEL留空，让各feature策略生效；MiMo语音及Qwen/MiMo OCR配置保留。
# ============================================

# 模拟对话：沉浸式多轮对话
AI_SIMULATION_PROVIDER=deepseek
AI_SIMULATION_MODEL=deepseek-v4-flash

# 评价与主观题使用Pro；测验简答使用Flash，分别配置
AI_EVALUATION_PROVIDER=deepseek
AI_EVALUATION_MODEL=deepseek-v4-pro
# 备用provider/model按文本策略配置
AI_EVALUATION_FALLBACK_PROVIDER=deepseek
AI_EVALUATION_FALLBACK_MODEL=deepseek-v4-flash

AI_QUIZ_GRADE_PROVIDER=deepseek
AI_QUIZ_GRADE_MODEL=deepseek-v4-flash
AI_SUBJECTIVE_GRADE_PROVIDER=deepseek
AI_SUBJECTIVE_GRADE_MODEL=deepseek-v4-pro

# AI 批量出题：创建任务流程中一次性用最强
AI_TASK_DRAFT_PROVIDER=deepseek
AI_TASK_DRAFT_MODEL=deepseek-v4-pro
AI_QUIZ_DRAFT_PROVIDER=deepseek
AI_QUIZ_DRAFT_MODEL=deepseek-v4-pro
AI_SUBJECTIVE_DRAFT_PROVIDER=deepseek
AI_SUBJECTIVE_DRAFT_MODEL=deepseek-v4-pro

# Teacher AI workbench tools
AI_LESSON_POLISH_PROVIDER=deepseek
AI_LESSON_POLISH_MODEL=deepseek-v4-pro
AI_IDEOLOGY_MINING_PROVIDER=deepseek
AI_IDEOLOGY_MINING_MODEL=deepseek-v4-pro
AI_QUESTION_ANALYSIS_PROVIDER=deepseek
AI_QUESTION_ANALYSIS_MODEL=deepseek-v4-flash
AI_EXAM_CHECK_PROVIDER=deepseek
AI_EXAM_CHECK_MODEL=deepseek-v4-pro

# Study Buddy：DeepSeek V4 Flash
AI_STUDY_BUDDY_PROVIDER=deepseek
AI_STUDY_BUDDY_MODEL=deepseek-v4-flash

AI_IMPORT_PROVIDER=deepseek
AI_IMPORT_MODEL=deepseek-v4-flash

# Insights：DeepSeek V4 Pro
AI_INSIGHTS_PROVIDER=deepseek
AI_INSIGHTS_MODEL=deepseek-v4-pro

# 一周洞察：按文本策略使用DeepSeek V4 Pro
AI_WEEKLY_INSIGHT_PROVIDER=deepseek
AI_WEEKLY_INSIGHT_MODEL=deepseek-v4-pro

# ============================================
# 限流
# ============================================
AI_RATE_LIMIT_ENABLED=true
AI_RATE_LIMIT_WINDOW_MS=3600000
AI_RATE_LIMIT_MAX_PER_FEATURE=100

# ============================================
# 功能开关
# ============================================
ENABLE_STUDY_BUDDY=true
# 生产环境默认关闭学生自助注册，只有明确开启才暴露公开班级列表与注册入口。
ENABLE_STUDENT_SELF_REGISTRATION=true

# ============================================
# 文件存储
# ============================================
FILE_STORAGE_TYPE=local
FILE_STORAGE_PATH=./data/uploads

# ============================================
# 服务配置
# ============================================
NODE_ENV=development
PORT=3000

AI_SIMULATION_FALLBACK_PROVIDER=deepseek

AI_SIMULATION_FALLBACK_MODEL=deepseek-v4-flash

AI_TASK_DRAFT_FALLBACK_PROVIDER=deepseek

AI_TASK_DRAFT_FALLBACK_MODEL=deepseek-v4-flash

AI_QUIZ_DRAFT_FALLBACK_PROVIDER=deepseek

AI_QUIZ_DRAFT_FALLBACK_MODEL=deepseek-v4-flash

AI_SUBJECTIVE_DRAFT_FALLBACK_PROVIDER=deepseek

AI_SUBJECTIVE_DRAFT_FALLBACK_MODEL=deepseek-v4-flash

AI_IMPORT_FALLBACK_PROVIDER=deepseek

AI_IMPORT_FALLBACK_MODEL=deepseek-v4-flash

AI_QUIZ_GRADE_FALLBACK_PROVIDER=deepseek

AI_QUIZ_GRADE_FALLBACK_MODEL=deepseek-v4-flash

AI_SUBJECTIVE_GRADE_FALLBACK_PROVIDER=deepseek

AI_SUBJECTIVE_GRADE_FALLBACK_MODEL=deepseek-v4-flash

AI_STUDY_BUDDY_FALLBACK_PROVIDER=deepseek

AI_STUDY_BUDDY_FALLBACK_MODEL=deepseek-v4-flash

AI_INSIGHTS_FALLBACK_PROVIDER=deepseek

AI_INSIGHTS_FALLBACK_MODEL=deepseek-v4-flash

AI_WEEKLY_INSIGHT_FALLBACK_PROVIDER=deepseek

AI_WEEKLY_INSIGHT_FALLBACK_MODEL=deepseek-v4-flash

AI_LESSON_POLISH_FALLBACK_PROVIDER=deepseek

AI_LESSON_POLISH_FALLBACK_MODEL=deepseek-v4-flash

AI_IDEOLOGY_MINING_FALLBACK_PROVIDER=deepseek

AI_IDEOLOGY_MINING_FALLBACK_MODEL=deepseek-v4-flash

AI_QUESTION_ANALYSIS_FALLBACK_PROVIDER=deepseek

AI_QUESTION_ANALYSIS_FALLBACK_MODEL=deepseek-v4-flash

AI_EXAM_CHECK_FALLBACK_PROVIDER=deepseek

AI_EXAM_CHECK_FALLBACK_MODEL=deepseek-v4-flash
